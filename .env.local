# ============================================
# LOCAL DEVELOPMENT CONFIGURATION
# ============================================
# Copy this to .env for local development:
#   copy .env.local .env  (Windows)
#   cp .env.local .env    (Linux/Mac)
#
# NEVER commit .env to git!
# ============================================

# Server
HOST=0.0.0.0
PORT=5001
NODE_ENV=development

# ============================================
# LOCAL MONGODB (via Docker)
# ============================================
DISABLE_MONGODB=false
MONGODB_URI=mongodb://skillbot_dev:dev_password_123@localhost:27017/?authSource=admin
MONGODB_DB_NAME=skillbot_local
MONGODB_DB_STOODY=stoody_b2c_local

# ============================================
# LOCAL REDIS (via Docker)
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# AI PROVIDERS
# Replace with your actual API keys
# ============================================
AI_PROVIDER=openai
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_KEY_HERE
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY_HERE
ANTHROPIC_MODEL=claude-3-sonnet-20240229
ANTHROPIC_BASE_URL=https://api.anthropic.com

MISTRAL_API_KEY=YOUR_MISTRAL_KEY_HERE
MISTRAL_OCR_MODEL=mistral-ocr-2512

SARVAM_API_KEY=sk_flkzqt7l_BCA7TYxSCwcDw0dG7GPm1Q1M

LANDING_AI_API_KEY=YOUR_LANDING_AI_KEY_HERE
LANDING_AI_API_URL=https://api.va.landing.ai/v1/tools/agentic-document-analysis
LANDING_AI_TIMEOUT=10000

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET_KEY=KBAfbaQwrEIktTIlOLY7CBq1nTwT54f3A5Ms58zX8tAC+exXCK2UjsNRMUuKeYEm
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth (optional for local B2C testing)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# 2FA Keys
TOTP_ENC_KEY=local-totp-encryption-key-32chars
APP_SECRET_KEY=local-app-secret-key-32-chars-ok

# ============================================
# CORS - Allow local frontend
# ============================================
FRONTEND_URL=http://localhost:5173

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
LOG_TO_FILE=true
LOG_FILE_PATH=./logs/app.log

# ============================================
# SMARTBOARD (optional)
# ============================================
SMARTBOARD_JWT_SECRET=local-smartboard-jwt-secret-key
SMARTBOARD_TOKEN_EXPIRY_HOURS=8
SMARTBOARD_BACKEND_URL=http://localhost:5002

