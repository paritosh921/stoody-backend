/* Skiller TUI Styles */

Screen {
    background: $surface;
}

.screen-title {
    text-style: bold;
    background: $accent;
    color: $text;
    padding: 0 1;
    height: auto;
    text-align: center;
}

/* ---- Dashboard ---- */

.stat-row {
    height: auto;
    margin: 1 0;
}

StatCard {
    width: 1fr;
    border: solid $accent;
    padding: 1 2;
    margin: 0 1;
    height: auto;
}

.stat-label {
    height: auto;
    color: $text-muted;
}

.stat-value {
    height: auto;
    text-style: bold;
    color: $text;
}

#dashboard-container {
    padding: 1;
}

/* ---- Common labels ---- */

.field-label {
    color: $text-muted;
    text-style: bold;
    height: auto;
    margin: 0 0 0 0;
    padding: 0 1;
}

/* ---- Pricing screen ---- */

#pricing-layout {
    height: 1fr;
}

#pricing-left {
    width: 40%;
    border-right: solid $accent;
    padding: 0 1;
}

#pricing-right {
    width: 60%;
    padding: 0 1;
    overflow-y: auto;
}

/* Force all direct children of pricing-right to auto-height */
#pricing-right > Static {
    height: auto;
}

#pricing-right > Select {
    height: auto;
}

#pricing-right > Button {
    height: auto;
}

.form-row {
    height: auto;
    margin: 0;
}

.form-row > Vertical {
    width: 1fr;
    height: auto;
    margin: 0 1 0 0;
}

.form-row Label {
    height: 1;
    margin: 0;
    padding: 0;
}

.form-row Input {
    height: auto;
    margin: 0 0 1 0;
}

#save-pricing {
    height: auto;
    margin: 1 0;
}

#pricing-status {
    height: auto;
    color: $success;
    margin: 0 1;
}

#sa-picker {
    height: 1fr;
}

/* ---- Tenants screen ---- */

#tenants-container {
    padding: 1;
}

#tenants-container > Static {
    height: auto;
}

#tenants-container > Select {
    height: auto;
}

#cost-table {
    height: 1fr;
    margin: 1 0;
}

#totals-line {
    height: auto;
    text-style: bold;
    background: $boost;
    padding: 0 1;
}

/* ---- Stats screen ---- */

#stats-container {
    padding: 1;
}

#stats-container > Static {
    height: auto;
}

#sa-summary-table {
    height: 1fr;
    min-height: 8;
}

#tier-table {
    height: auto;
    min-height: 6;
    max-height: 12;
}

/* ---- Billing screen ---- */

#billing-layout {
    height: 1fr;
}

#billing-left {
    width: 40%;
    border-right: solid $accent;
    padding: 0 1;
}

#billing-right {
    width: 60%;
    padding: 0 1;
    overflow-y: auto;
}

#billing-summary-panel {
    height: auto;
    padding: 1;
    border: solid $accent;
    margin: 1 0;
    color: $text;
}

#billing-sa-select {
    height: auto;
}

#payments-table {
    height: auto;
    min-height: 6;
    max-height: 16;
    margin: 1 0;
}

#billing-status {
    height: auto;
    color: $success;
    margin: 0 1;
}

#record-payment {
    height: auto;
    margin: 1 0;
}

/* ---- Super-Admins screen ---- */

#sa-status-bar {
    height: auto;
    background: $boost;
    color: $text;
    padding: 0 1;
}

/* ---- Global DataTable default ---- */

DataTable {
    height: 1fr;
}

/* ---- Diagnostics screen ---- */

#diagnostics-container {
    padding: 1;
}

#diag-table {
    height: 11;
}

#diag-status-bar {
    height: auto;
    background: $boost;
    color: $text;
    padding: 0 1;
}

#diag-actions {
    height: auto;
    margin: 0 0 1 0;
}

#diag-copy,
#diag-delete-selected,
#diag-delete-all {
    height: auto;
    margin-right: 1;
}

#diag-details {
    height: auto;
}

#diag-details-pane {
    height: 1fr;
    border: solid $accent;
    padding: 1;
    overflow-y: auto;
}

/* ---- Desktop Messages screen ---- */

#bug-reports-container {
    padding: 1;
}

#bug-table {
    height: 11;
}

#bug-status-bar {
    height: auto;
    background: $boost;
    color: $text;
    padding: 0 1;
}

#bug-transfer-panel {
    height: auto;
    border: solid $accent;
    padding: 1;
    margin: 0 0 1 0;
}

.bug-transfer-row {
    height: auto;
    margin: 0 0 1 0;
}

.bug-transfer-row > Input {
    width: 1fr;
    margin-right: 1;
}

#bug-transfer-actions {
    height: auto;
}

#bug-transfer-actions > Button {
    margin-right: 1;
}

#bug-actions {
    height: auto;
    margin: 0 0 1 0;
}

#bug-copy,
#bug-send-images,
#bug-delete-selected,
#bug-delete-all {
    height: auto;
    margin-right: 1;
}

#bug-details {
    height: auto;
}

#bug-details-pane {
    height: 1fr;
    border: solid $accent;
    padding: 1;
    overflow-y: auto;
}
