# =============================================================
# ExamPen Local Dev Stack — Environment Variables
# Copy to .env and adjust as needed
# =============================================================

# PostgreSQL
POSTGRES_USER=exampen
POSTGRES_PASSWORD=exampen_dev
POSTGRES_DB=exampen_auth

# Redis
REDIS_PASSWORD=exampen_redis_dev

# MinIO
MINIO_ROOT_USER=exampen
MINIO_ROOT_PASSWORD=exampen_minio_dev

# NATS
NATS_USER=exampen
NATS_PASSWORD=exampen_nats_dev

# Traefik
TRAEFIK_DASHBOARD_USER=admin
TRAEFIK_DASHBOARD_PASSWORD=admin

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Service shared env
AUTH_SERVICE_URL=http://svc-auth:8000
NATS_URL=nats://nats:4222
MINIO_URL=http://minio:9000
MINIO_ACCESS_KEY=exampen
MINIO_SECRET_KEY=exampen_minio_dev
REDIS_URL=redis://:exampen_redis_dev@redis:6379/0
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=exampen
DATABASE_PASSWORD=exampen_dev
