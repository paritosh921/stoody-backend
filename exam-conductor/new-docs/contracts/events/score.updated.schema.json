{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exampen/events/score.updated",
  "title": "score.updated event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "exam_id",
    "student_id",
    "lifecycle_state",
    "total_score",
    "reason"
  ],
  "properties": {
    "event_id": { "type": "string" },
    "event_type": { "const": "score.updated" },
    "event_version": { "const": "1.0.0" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "exam_id": { "type": "string", "format": "uuid" },
    "student_id": { "type": "string" },
    "question_id": { "type": "string" },
    "lifecycle_state": {
      "type": "string",
      "enum": ["ai_draft", "teacher_reviewed", "finalized", "published", "objection_window", "locked"]
    },
    "total_score": { "type": "number" },
    "previous_total_score": { "type": "number" },
    "reason": {
      "type": "string",
      "enum": ["ai_draft_created", "override_applied", "finalized", "published", "objection_rescored"]
    }
  }
}
