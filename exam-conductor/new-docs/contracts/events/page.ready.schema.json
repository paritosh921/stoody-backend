{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exampen/events/page.ready",
  "title": "page.ready event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "exam_id",
    "student_id",
    "page_id",
    "page_number",
    "image_uri",
    "authoritative_source"
  ],
  "properties": {
    "event_id": { "type": "string" },
    "event_type": { "const": "page.ready" },
    "event_version": { "const": "1.0.0" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "exam_id": { "type": "string", "format": "uuid" },
    "student_id": { "type": "string" },
    "page_id": { "type": "string" },
    "page_number": { "type": "integer" },
    "image_uri": { "type": "string", "format": "uri" },
    "vector_uri": { "type": "string", "format": "uri" },
    "authoritative_source": {
      "type": "string",
      "enum": ["strokes", "copy_image", "both"]
    },
    "question_ids": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
