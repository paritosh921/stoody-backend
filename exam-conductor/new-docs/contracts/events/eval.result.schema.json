{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exampen/events/eval.result",
  "title": "eval.result event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "event_version", "occurred_at", "evaluation_id", "response_id", "question_id", "total_score"],
  "properties": {
    "event_id": { "type": "string" },
    "event_type": { "const": "eval.result" },
    "event_version": { "const": "2.0.0" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "evaluation_id": { "type": "string" },
    "response_id": { "type": "string" },
    "question_id": { "type": "string" },
    "total_score": { "type": "number" },
    "gate_call_refs": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
