{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exampen/events/eval.segmentation.complete",
  "title": "eval.segmentation.complete event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "event_version", "occurred_at", "submission_id", "response_count"],
  "properties": {
    "event_id": { "type": "string" },
    "event_type": { "const": "eval.segmentation.complete" },
    "event_version": { "const": "2.0.0" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "submission_id": { "type": "string" },
    "response_count": { "type": "integer" },
    "blocking_flag_count": { "type": "integer" }
  }
}
