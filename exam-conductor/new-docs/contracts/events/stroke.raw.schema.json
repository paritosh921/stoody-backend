{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exampen/events/stroke.raw",
  "title": "stroke.raw event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "exam_id",
    "exam_type",
    "pen_mac",
    "chunk_index",
    "total_chunks",
    "payload_base64",
    "upload_path"
  ],
  "properties": {
    "event_id": { "type": "string" },
    "event_type": { "const": "stroke.raw" },
    "event_version": { "const": "2.0.0" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "exam_id": { "type": "string" },
    "exam_type": { "type": "string", "enum": ["dcr", "pcr"] },
    "pen_mac": { "type": "string" },
    "student_id": { "type": "string" },
    "chunk_index": { "type": "integer" },
    "total_chunks": { "type": "integer" },
    "payload_base64": { "type": "string" },
    "upload_path": { "type": "string", "enum": ["wifi", "mobile"] }
  }
}
