{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exampen/events/plagiarism.result",
  "title": "plagiarism.result event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "exam_id",
    "flags"
  ],
  "properties": {
    "event_id": { "type": "string" },
    "event_type": { "const": "plagiarism.result" },
    "event_version": { "const": "2.0.0" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "exam_id": { "type": "string" },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["flag_id", "question_id", "severity"],
        "properties": {
          "flag_id": { "type": "string" },
          "question_id": { "type": "string" },
          "severity": { "type": "string" },
          "student_a_id": { "type": "string" },
          "student_b_id": { "type": "string" }
        }
      }
    }
  }
}
